    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reports Healthy\", () => pm.expect(pm.response.text()).to.eql(\"Healthy\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 once a snapshot exists\", () => pm.response.to.have.status(200));",
                  "",
                  "const report = pm.response.json();",
                  "",
                  "pm.test(\"Overall status is Healthy or Degraded\", () => pm.expect(report.status).to.be.oneOf([\"Healthy\", \"Degraded\"]));",
                  "pm.test(\"Reports when the snapshot was taken\", () => {",
                  "    const check = report.checks[\"best-stories\"];",
                  "    pm.expect(check.data.refreshedAt).to.be.a(\"string\");",
                  "    pm.expect(check.data.ageSeconds).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documentation",
      "item": [
        {
          "name": "OpenAPI document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/openapi/v1.json",
              "host": ["{{baseUrl}}"],
              "path": ["openapi", "v1.json"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Documents the best stories endpoint\", () => {",
                  "    pm.expect(pm.response.json().paths).to.have.property(\"/api/stories/best\");",
                  "});",
                  "",
                  "pm.test(\"Describes n as a required integer\", () => {",
                  "    const n = pm.response.json().paths[\"/api/stories/best\"].get.parameters.find(p => p.name === \"n\");",
                  "    pm.expect(n.required).to.be.true;",
                  "    pm.expect(n.schema.type).to.eql(\"integer\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
